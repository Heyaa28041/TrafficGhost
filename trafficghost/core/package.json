{
  "name": "@trafficghost/core",
  "version": "1.0.0",
  "description": "TrafficGhost core engine — HAR parsing, API analysis, mock generation, and behavior engine",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
